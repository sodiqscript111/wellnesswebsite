---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import JournalSandbox from '../components/JournalSandbox.astro';
import DailyRituals from '../components/DailyRituals.astro';
import AppFeatures from '../components/AppFeatures.astro';
import PhilosophyAndFAQ from '../components/PhilosophyAndFAQ.astro';
import CommunitySection from '../components/CommunitySection.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="I Am Well — Daily Mindful Documenting & Wellness Companion">
	<Navbar />

	<main class="hero-section">
		<div class="hero-container">
			<div class="hero-tag-wrap">
				<span id="hero-tag" class="hero-tag">A mindful sanctuary for your mind</span>
			</div>

			<h1 class="hero-title">
				Document your days with <span id="hero-highlight" class="hero-highlight">clarity</span>, gratitude, and <span id="hero-circle" class="hero-circle-word">calm</span>.
			</h1>

			<p class="hero-description">
				<strong>I Am Well</strong> is a serene digital journal and daily wellness ritual app. 
				Capture fleeting thoughts, track emotional weather, and reconnect with yourself—one gentle entry at a time.
			</p>

			<div class="hero-actions">
				<button type="button" id="hero-cta-btn" class="cta-button-primary">
					Download the App — Free
				</button>
				<button type="button" id="hero-secondary-btn" class="cta-button-secondary">
					Explore Documenting Rituals
				</button>
			</div>

			<div class="showcase-section">
				<JournalSandbox />
			</div>
		</div>
	</main>

	<DailyRituals />
	<AppFeatures />
	<PhilosophyAndFAQ />
	<CommunitySection />
	<DownloadCTA />
	<Footer />
</Layout>

<script>
	import {
		drawablyButton,
		drawablyHighlight,
		drawablyCircle,
		drawablyBadge,
	} from "drawably";

	function initHeroDrawably() {
		const heroTag = document.querySelector<HTMLElement>("#hero-tag");
		if (heroTag) {
			drawablyBadge(heroTag, { variant: "outline", roughness: 0.9 });
		}

		const heroHighlight = document.querySelector<HTMLElement>("#hero-highlight");
		if (heroHighlight) {
			drawablyHighlight(heroHighlight, { roughness: 1.1 });
		}

		const heroCircle = document.querySelector<HTMLElement>("#hero-circle");
		if (heroCircle) {
			drawablyCircle(heroCircle, { roughness: 1.2 });
		}

		const heroCtaBtn = document.querySelector<HTMLElement>("#hero-cta-btn");
		if (heroCtaBtn) {
			drawablyButton(heroCtaBtn, {
				variant: "solid",
				fill: "#253830",
				stroke: "#253830",
				paper: "#ffffff",
				roughness: 1.0,
			});
		}

		const heroSecondaryBtn = document.querySelector<HTMLElement>("#hero-secondary-btn");
		if (heroSecondaryBtn) {
			drawablyButton(heroSecondaryBtn, { variant: "outline", tone: "neutral", roughness: 0.9 });
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initHeroDrawably);
	} else {
		initHeroDrawably();
	}
	document.addEventListener("astro:page-load", initHeroDrawably);
</script>

<style>
	.hero-section {
		padding: 72px 24px 96px;
		background: radial-gradient(circle at 50% 10%, rgba(227, 239, 230, 0.45) 0%, transparent 60%);
	}

	.hero-container {
		max-width: 860px;
		margin: 0 auto;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero-tag-wrap {
		margin-bottom: 24px;
	}

	.hero-tag {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent-sage);
		padding: 4px 14px;
		display: inline-block;
	}

	.hero-title {
		font-family: var(--font-serif);
		font-size: clamp(2.25rem, 5vw, 3.75rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.025em;
		color: var(--text-primary);
		margin-bottom: 24px;
	}

	.hero-highlight {
		font-style: italic;
		color: var(--accent-sage-dark);
		padding: 0 6px;
	}

	.hero-circle-word {
		font-style: italic;
		color: var(--accent-terracotta);
		padding: 0 4px;
	}

	.hero-description {
		font-family: var(--font-sans);
		font-size: 1.1875rem;
		font-weight: 400;
		line-height: 1.75;
		letter-spacing: -0.012em;
		color: var(--text-secondary);
		max-width: 620px;
		margin-bottom: 36px;
	}

	.hero-description strong {
		color: var(--text-primary);
		font-weight: 600;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		flex-wrap: wrap;
		margin-bottom: 64px;
	}

	.cta-button-primary {
		--drawably-fill: #253830;
		--drawably-stroke: #253830;
		--drawably-paper: #ffffff;
		font-size: 1rem;
		font-weight: 600;
		padding: 12px 28px;
		background: transparent;
		border: none;
		color: #ffffff !important;
		cursor: pointer;
		position: relative;
		z-index: 1;
	}

	.cta-button-secondary {
		font-size: 1rem;
		font-weight: 500;
		padding: 12px 24px;
		background: transparent;
		border: none;
		color: var(--text-secondary);
		cursor: pointer;
	}

	.showcase-section {
		width: 100%;
		max-width: 720px;
		margin: 0 auto;
	}

	@media (max-width: 600px) {
		.hero-section {
			padding: 48px 16px 64px;
		}

		.hero-actions {
			flex-direction: column;
			width: 100%;
		}

		.cta-button-primary,
		.cta-button-secondary {
			width: 100%;
		}
	}
</style>
