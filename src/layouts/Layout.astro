---
import "drawably/style.css";

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "I Am Well — Mindful Documenting & Wellness Companion", 
	description = "A gentle space to document your daily thoughts, track wellness rituals, and cultivate inner peace." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--drawably-stroke: #253830;
		--drawably-fill: #e6efe8;
		--drawably-paper: #faf8f5;
		--drawably-width: 1.6;
		--drawably-error: #c84b42;
		--drawably-success: #2b7a4b;

		--bg-cream: #faf8f5;
		--bg-surface: #ffffff;
		--bg-sage-subtle: #f0f5f1;
		--bg-terracotta-subtle: #faf2ee;
		--text-primary: #1f2d27;
		--text-secondary: #42554c;
		--text-muted: #6e8277;
		--accent-sage: #3d6352;
		--accent-sage-dark: #253830;
		--accent-terracotta: #c86c4f;
		--border-soft: rgba(37, 56, 48, 0.12);

		--font-sans: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
		--font-serif: 'Newsreader', Georgia, serif;
		--font-display: 'Outfit', 'Inter', sans-serif;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html,
	body {
		background-color: var(--bg-cream);
		color: var(--text-primary);
		font-family: var(--font-sans);
		min-height: 100%;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		overflow-x: hidden;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button {
		font-family: inherit;
		cursor: pointer;
	}

	::selection {
		background: #d8e8dc;
		color: #1a2c24;
	}

	.drawably-host {
		position: relative !important;
		isolation: isolate;
	}

	.drawably-svg {
		position: absolute !important;
		inset: 0 !important;
		width: 100% !important;
		height: 100% !important;
		overflow: visible !important;
		pointer-events: none !important;
		z-index: 0 !important;
	}

	.drawably-svg path {
		stroke: var(--drawably-stroke, #253830);
		vector-effect: non-scaling-stroke;
	}

	.drawably-reveal {
		opacity: 0;
		transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.drawably-reveal.is-visible {
		opacity: 1;
	}
</style>
