---
---

<header class="site-header">
  <div class="top-banner">
    <div class="banner-inner">
      <span class="banner-badge" id="banner-badge">Gentle Space</span>
      <span class="banner-text">Take a deep breath. Document your journey with intention.</span>
      <a href="#download" class="banner-link">Try the app &rarr;</a>
    </div>
  </div>

  <nav class="navbar" aria-label="Main Navigation">
    <div class="nav-container">
      <a href="/" class="brand-link" aria-label="I Am Well Home">
        <div class="brand-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a10 10 0 0 1 10 10c0 5.523-4.477 10-10 10S2 17.523 2 12c0-2.5 1-4.8 2.6-6.5" />
            <path d="M12 6v6l4 2" />
            <path d="M16.5 3.5c1.5 1.5 2.5 3.5 2.5 5.5" />
          </svg>
        </div>
        <div class="brand-text-wrap">
          <span class="brand-title">I Am <span id="brand-circle" class="brand-highlight">Well</span></span>
          <span class="brand-tagline">wellness & documenting</span>
        </div>
      </a>

      <div class="nav-actions">
        <a href="#download" class="cta-link-wrapper">
          <button type="button" id="btn-cta" class="nav-btn-primary">
            Get App
          </button>
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  import {
    drawablyButton,
    drawablyCircle,
    drawablyBadge
  } from "drawably";

  function initDrawablyNav() {
    const brandCircle = document.querySelector<HTMLElement>("#brand-circle");
    if (brandCircle) {
      drawablyCircle(brandCircle, {
        roughness: 1.1,
        boil: 0.25,
      });
    }

    const bannerBadge = document.querySelector<HTMLElement>("#banner-badge");
    if (bannerBadge) {
      drawablyBadge(bannerBadge, {
        variant: "scribble",
        roughness: 0.8,
      });
    }

    const btnCta = document.querySelector<HTMLElement>("#btn-cta");
    if (btnCta) {
      drawablyButton(btnCta, {
        variant: "solid",
        fill: "#253830",
        stroke: "#253830",
        paper: "#ffffff",
        roughness: 1.0,
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDrawablyNav);
  } else {
    initDrawablyNav();
  }
  document.addEventListener("astro:page-load", initDrawablyNav);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(250, 248, 245, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-soft);
    transition: background-color 0.2s ease;
  }

  .top-banner {
    background: var(--bg-sage-subtle);
    border-bottom: 1px dashed rgba(37, 56, 48, 0.12);
    font-size: 0.8125rem;
    padding: 6px 16px;
    color: var(--text-secondary);
  }

  .banner-inner {
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    text-align: center;
  }

  .banner-badge {
    font-size: 0.725rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-sage);
    padding: 2px 8px;
    display: inline-block;
  }

  .banner-text {
    font-weight: 450;
    letter-spacing: -0.01em;
  }

  .banner-link {
    font-weight: 600;
    color: var(--accent-sage-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .banner-link:hover {
    color: var(--accent-terracotta);
  }

  .navbar {
    width: 100%;
    padding: 12px 24px;
  }

  .nav-container {
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    user-select: none;
  }

  .brand-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--bg-sage-subtle);
    border: 1.5px solid var(--accent-sage);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-sage);
    box-shadow: 0 2px 8px rgba(37, 56, 48, 0.06);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .brand-link:hover .brand-icon {
    transform: rotate(12deg) scale(1.05);
  }

  .brand-text-wrap {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .brand-highlight {
    display: inline-block;
    padding: 0 4px;
    color: var(--accent-sage);
    font-style: italic;
  }

  .brand-tagline {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cta-link-wrapper {
    display: inline-block;
    text-decoration: none;
  }

  .nav-btn-primary {
    --drawably-fill: #253830;
    --drawably-stroke: #253830;
    --drawably-paper: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 8px 20px;
    border-radius: 6px;
    background: transparent;
    border: none;
    color: #ffffff !important;
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 600px) {
    .top-banner {
      display: none;
    }

    .navbar {
      padding: 10px 16px;
    }

    .brand-title {
      font-size: 1.25rem;
    }

    .nav-btn-primary {
      padding: 7px 16px;
      font-size: 0.8125rem;
    }
  }
</style>
