---
---

<section id="download" class="download-section drawably-reveal">
  <div class="download-container">
    <div class="cta-banner" id="cta-banner-card">
      <div class="cta-header">
        <div class="badge-wrap">
          <span id="cta-badge" class="cta-badge">Begin Your Practice</span>
        </div>
        <h2 class="cta-title">
          Find your stillness today. <span id="cta-hl" class="highlight-word">Download</span> I Am Well.
        </h2>
        <p class="cta-subtitle">
          Your gentle sanctuary is ready whenever you need a pause. No subscriptions required for daily mindful documenting.
        </p>
      </div>

      <div class="platform-grid">
        <div class="platform-card" id="platform-card-1">
          <div class="platform-top">
            <span class="platform-chip" id="plat-chip-1">Mobile</span>
            <span class="platform-sub">iOS & Android</span>
          </div>

          <h3 class="platform-heading">I Am Well for Mobile</h3>
          <p class="platform-desc">
            Keep your gentle wellness companion in your pocket with lock screen widgets and tactile somatic haptics.
          </p>

          <ul class="platform-features">
            <li>Lock screen reflection widgets</li>
            <li>Gentle haptic breath pacing</li>
            <li>Biometric Face ID private vault</li>
          </ul>

          <div class="platform-actions">
            <button type="button" id="btn-app-store" class="btn-appstore">
              Download on App Store
            </button>
            <button type="button" id="btn-google-play" class="btn-playstore">
              Get on Google Play
            </button>
          </div>
        </div>

        <div class="platform-card" id="platform-card-2">
          <div class="platform-top">
            <span class="platform-chip" id="plat-chip-2">Desktop</span>
            <span class="platform-sub">macOS & Web</span>
          </div>

          <h3 class="platform-heading">Web & Desktop Sanctuary</h3>
          <p class="platform-desc">
            An expansive, distraction-free writing environment with serene typography and ambient soundscapes.
          </p>

          <ul class="platform-features">
            <li>Full-screen focus writing mode</li>
            <li>Ambient rain & forest audio tracks</li>
            <li>Local encrypted offline backup</li>
          </ul>

          <div class="platform-actions">
            <button type="button" id="btn-web-sanctuary" class="btn-launch-web">
              Open Web Sanctuary &rarr;
            </button>
          </div>
        </div>
      </div>

      <div class="guarantee-strip">
        <span class="guarantee-badge" id="guar-badge-1">100% Free Core Rituals</span>
        <span class="guarantee-badge" id="guar-badge-2">Zero-Knowledge Encryption</span>
        <span class="guarantee-badge" id="guar-badge-3">No Ads or Streak Guilt</span>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    drawablyCard,
    drawablyButton,
    drawablyBadge,
    drawablyHighlight,
  } from "drawably";

  async function initDownloadCTA() {
    if (document.fonts) {
      try {
        await document.fonts.ready;
      } catch (_) {}
    }

    const section = document.querySelector<HTMLElement>("#download");

    const ctaBadge = document.querySelector<HTMLElement>("#cta-badge");
    if (ctaBadge && !ctaBadge.dataset.drawn) {
      ctaBadge.dataset.drawn = "1";
      drawablyBadge(ctaBadge, { variant: "scribble", roughness: 0.8 });
    }

    const ctaHl = document.querySelector<HTMLElement>("#cta-hl");
    if (ctaHl && !ctaHl.dataset.drawn) {
      ctaHl.dataset.drawn = "1";
      drawablyHighlight(ctaHl, { roughness: 1.1 });
    }

    const bannerCard = document.querySelector<HTMLElement>("#cta-banner-card");
    if (bannerCard && !bannerCard.dataset.drawn) {
      bannerCard.dataset.drawn = "1";
      drawablyCard(bannerCard, { roughness: 1.0 });
    }

    const platCards = ["#platform-card-1", "#platform-card-2"];
    platCards.forEach((id) => {
      const card = document.querySelector<HTMLElement>(id);
      if (card && !card.dataset.drawn) {
        card.dataset.drawn = "1";
        drawablyCard(card, { roughness: 1.05 });
      }
    });

    const chipIds = ["#plat-chip-1", "#plat-chip-2"];
    chipIds.forEach((id) => {
      const chip = document.querySelector<HTMLElement>(id);
      if (chip && !chip.dataset.drawn) {
        chip.dataset.drawn = "1";
        drawablyBadge(chip, { variant: "outline", roughness: 0.85 });
      }
    });

    const guarIds = ["#guar-badge-1", "#guar-badge-2", "#guar-badge-3"];
    guarIds.forEach((id) => {
      const el = document.querySelector<HTMLElement>(id);
      if (el && !el.dataset.drawn) {
        el.dataset.drawn = "1";
        drawablyBadge(el, { variant: "outline", roughness: 0.9 });
      }
    });

    const btnAppStore = document.querySelector<HTMLElement>("#btn-app-store");
    if (btnAppStore && !btnAppStore.dataset.drawn) {
      btnAppStore.dataset.drawn = "1";
      drawablyButton(btnAppStore, {
        variant: "solid",
        fill: "#253830",
        stroke: "#253830",
        paper: "#ffffff",
        roughness: 1.0,
      });
    }

    const btnGooglePlay = document.querySelector<HTMLElement>("#btn-google-play");
    if (btnGooglePlay && !btnGooglePlay.dataset.drawn) {
      btnGooglePlay.dataset.drawn = "1";
      drawablyButton(btnGooglePlay, {
        variant: "outline",
        tone: "neutral",
        roughness: 0.9,
      });
    }

    const btnWeb = document.querySelector<HTMLElement>("#btn-web-sanctuary");
    if (btnWeb && !btnWeb.dataset.drawn) {
      btnWeb.dataset.drawn = "1";
      drawablyButton(btnWeb, {
        variant: "solid",
        fill: "#253830",
        stroke: "#253830",
        paper: "#ffffff",
        roughness: 1.0,
      });
    }

    if (section) {
      section.classList.add("is-visible");
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDownloadCTA);
  } else {
    initDownloadCTA();
  }
  document.addEventListener("astro:page-load", initDownloadCTA);
</script>

<style>
  .download-section {
    padding: 96px 24px;
    background-color: var(--bg-cream);
    border-top: 1px solid var(--border-soft);
  }

  .download-container {
    max-width: 1140px;
    margin: 0 auto;
  }

  .cta-banner {
    background: #ffffff;
    padding: 56px 48px;
    border-radius: 4px;
    box-shadow: 0 12px 36px rgba(37, 56, 48, 0.06);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .cta-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .cta-badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-sage);
    padding: 2px 10px;
    display: inline-block;
  }

  .cta-title {
    font-family: var(--font-serif);
    font-size: clamp(2.15rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .highlight-word {
    font-style: italic;
    color: var(--accent-sage-dark);
    padding: 0 4px;
  }

  .cta-subtitle {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .platform-card {
    background: var(--bg-sage-subtle);
    padding: 36px 32px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .platform-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px dashed rgba(37, 56, 48, 0.12);
  }

  .platform-chip {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-sage);
    padding: 2px 8px;
  }

  .platform-sub {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .platform-heading {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.015em;
  }

  .platform-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .platform-features {
    list-style: disc;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: auto;
  }

  .platform-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 16px;
  }

  .btn-appstore,
  .btn-launch-web {
    --drawably-fill: #253830;
    --drawably-stroke: #253830;
    --drawably-paper: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 10px 22px;
    background: transparent;
    border: none;
    color: #ffffff !important;
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  .btn-playstore {
    font-size: 0.875rem;
    font-weight: 500;
    padding: 10px 18px;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .guarantee-strip {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px dashed rgba(37, 56, 48, 0.12);
  }

  .guarantee-badge {
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--text-secondary);
    padding: 4px 12px;
  }

  @media (max-width: 900px) {
    .cta-banner {
      padding: 36px 20px;
    }

    .platform-grid {
      grid-template-columns: 1fr;
    }

    .download-section {
      padding: 64px 16px;
    }
  }
</style>
