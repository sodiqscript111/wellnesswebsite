---
---

<section id="features" class="features-section drawably-reveal">
  <div class="features-container">
    <div class="features-header">
      <div class="badge-wrap">
        <span id="features-badge" class="features-badge">App Features</span>
      </div>
      <h2 class="features-title">
        Crafted like a <span id="features-hl" class="highlight-word">linen notebook</span>, not a noisy social feed.
      </h2>
      <p class="features-subtitle">
        Every tool in <em>I Am Well</em> is designed to reduce sensory overload, protect your inner thoughts, and invite gentle introspection.
      </p>
    </div>

    <div class="features-grid">
      <div class="feature-card" id="feat-card-1">
        <div class="feature-top">
          <span class="feature-chip" id="feat-chip-1">Library</span>
          <span class="feature-meta">200+ Guided Prompts</span>
        </div>

        <h3 class="feature-heading">The Prompt Sanctuary</h3>
        <p class="feature-desc">
          When staring at a blank page feels intimidating, open our categorized sanctuary of gentle questions created with therapists and mindfulness facilitators.
        </p>

        <div class="tag-cloud">
          <span class="category-pill" id="cat-pill-1">#Burnout & Rest</span>
          <span class="category-pill" id="cat-pill-2">#Healthy Boundaries</span>
          <span class="category-pill" id="cat-pill-3">#Self-Compassion</span>
          <span class="category-pill" id="cat-pill-4">#Inner Child</span>
          <span class="category-pill" id="cat-pill-5">#Letting Go</span>
        </div>

        <div class="mini-prompt-preview">
          <span class="preview-quote">"What is a standard you are holding yourself to that no one else asked for?"</span>
        </div>
      </div>

      <div class="feature-card" id="feat-card-2">
        <div class="feature-top">
          <span class="feature-chip" id="feat-chip-2">Insights</span>
          <span class="feature-meta">Pattern Discovery</span>
        </div>

        <h3 class="feature-heading">Emotional Weather Map</h3>
        <p class="feature-desc">
          See your week without pressure or streaks. Understand what days drain your energy, and which rituals bring your peace back into balance.
        </p>

        <div class="weather-week-box">
          <div class="weather-days">
            <div class="day-col">
              <span class="day-name">Mon</span>
              <span class="weather-icon">🌧️</span>
              <span class="day-dot dot-rainy"></span>
            </div>
            <div class="day-col">
              <span class="day-name">Tue</span>
              <span class="weather-icon">⛅</span>
              <span class="day-dot dot-neutral"></span>
            </div>
            <div class="day-col">
              <span class="day-name">Wed</span>
              <span class="weather-icon">🌿</span>
              <span class="day-dot dot-calm"></span>
            </div>
            <div class="day-col">
              <span class="day-name">Thu</span>
              <span class="weather-icon">🌿</span>
              <span class="day-dot dot-calm"></span>
            </div>
            <div class="day-col">
              <span class="day-name">Fri</span>
              <span class="weather-icon">✨</span>
              <span class="day-dot dot-grateful"></span>
            </div>
            <div class="day-col">
              <span class="day-name">Sat</span>
              <span class="weather-icon">⚓</span>
              <span class="day-dot dot-grounded"></span>
            </div>
            <div class="day-col">
              <span class="day-name">Sun</span>
              <span class="weather-icon">🌿</span>
              <span class="day-dot dot-calm"></span>
            </div>
          </div>
          <div class="weather-insight-line">
            <span class="insight-badge">Weekly Trend</span>
            <span class="insight-text">5 out of 7 days felt grounded following morning tea rituals.</span>
          </div>
        </div>
      </div>

      <div class="feature-card" id="feat-card-3">
        <div class="feature-top">
          <span class="feature-chip" id="feat-chip-3">Privacy</span>
          <span class="feature-meta">Zero Telemetry</span>
        </div>

        <h3 class="feature-heading">Zero-Knowledge Vault</h3>
        <p class="feature-desc">
          Your thoughts belong to you alone. All entries are encrypted on your device. No cloud ad-trackers, no selling data, no algorithms peeking into your reflections.
        </p>

        <div class="security-toggles-box">
          <label class="toggle-row">
            <span class="toggle-wrap" id="toggle-wrap-1"><input type="checkbox" checked /></span>
            <span class="toggle-label">Biometric App Lock (Face ID / Touch ID)</span>
          </label>
          <label class="toggle-row">
            <span class="toggle-wrap" id="toggle-wrap-2"><input type="checkbox" checked /></span>
            <span class="toggle-label">Offline-First Local Storage</span>
          </label>
          <label class="toggle-row">
            <span class="toggle-wrap" id="toggle-wrap-3"><input type="checkbox" checked /></span>
            <span class="toggle-label">End-to-End Encrypted Backups</span>
          </label>
        </div>
      </div>

      <div class="feature-card" id="feat-card-4">
        <div class="feature-top">
          <span class="feature-chip" id="feat-chip-4">Accessibility</span>
          <span class="feature-meta">Voice & Vision</span>
        </div>

        <h3 class="feature-heading">Whisper Audio & Photos</h3>
        <p class="feature-desc">
          On evenings when your hands are tired, press and speak your mind into a private voice note, or attach one serene photo that anchored your day.
        </p>

        <div class="audio-demo-box">
          <div class="audio-player-mock">
            <button type="button" class="audio-play-btn" aria-label="Play sample audio note">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </button>
            <div class="audio-waveform-bars">
              <span class="bar bar-1"></span>
              <span class="bar bar-2"></span>
              <span class="bar bar-3"></span>
              <span class="bar bar-4"></span>
              <span class="bar bar-5"></span>
              <span class="bar bar-6"></span>
              <span class="bar bar-7"></span>
              <span class="bar bar-8"></span>
              <span class="bar bar-9"></span>
              <span class="bar bar-10"></span>
            </div>
            <span class="audio-length">1:42</span>
          </div>
          <span class="audio-caption">"Reflections on my quiet afternoon walk under the trees..."</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    drawablyCard,
    drawablyBadge,
    drawablyToggle,
    drawablyHighlight,
  } from "drawably";

  async function initAppFeatures() {
    if (document.fonts) {
      try {
        await document.fonts.ready;
      } catch (_) {}
    }

    const section = document.querySelector<HTMLElement>("#features");

    const featuresBadge = document.querySelector<HTMLElement>("#features-badge");
    if (featuresBadge && !featuresBadge.dataset.drawn) {
      featuresBadge.dataset.drawn = "1";
      drawablyBadge(featuresBadge, { variant: "scribble", roughness: 0.8 });
    }

    const featuresHl = document.querySelector<HTMLElement>("#features-hl");
    if (featuresHl && !featuresHl.dataset.drawn) {
      featuresHl.dataset.drawn = "1";
      drawablyHighlight(featuresHl, { roughness: 1.1 });
    }

    const featCards = ["#feat-card-1", "#feat-card-2", "#feat-card-3", "#feat-card-4"];
    featCards.forEach((id) => {
      const card = document.querySelector<HTMLElement>(id);
      if (card && !card.dataset.drawn) {
        card.dataset.drawn = "1";
        drawablyCard(card, { roughness: 1.05 });
      }
    });

    const chipIds = ["#feat-chip-1", "#feat-chip-2", "#feat-chip-3", "#feat-chip-4"];
    chipIds.forEach((id) => {
      const chip = document.querySelector<HTMLElement>(id);
      if (chip && !chip.dataset.drawn) {
        chip.dataset.drawn = "1";
        drawablyBadge(chip, { variant: "outline", roughness: 0.9 });
      }
    });

    const catIds = ["#cat-pill-1", "#cat-pill-2", "#cat-pill-3", "#cat-pill-4", "#cat-pill-5"];
    catIds.forEach((id) => {
      const pill = document.querySelector<HTMLElement>(id);
      if (pill && !pill.dataset.drawn) {
        pill.dataset.drawn = "1";
        drawablyBadge(pill, { variant: "outline", roughness: 0.85 });
      }
    });

    const toggleIds = ["#toggle-wrap-1", "#toggle-wrap-2", "#toggle-wrap-3"];
    toggleIds.forEach((id) => {
      const wrap = document.querySelector<HTMLElement>(id);
      if (wrap && !wrap.dataset.drawn) {
        wrap.dataset.drawn = "1";
        drawablyToggle(wrap, { roughness: 1.0 });
      }
    });

    if (section) {
      section.classList.add("is-visible");
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAppFeatures);
  } else {
    initAppFeatures();
  }
  document.addEventListener("astro:page-load", initAppFeatures);
</script>

<style>
  .features-section {
    padding: 96px 24px;
    background-color: var(--bg-cream);
    border-top: 1px solid var(--border-soft);
  }

  .features-container {
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .features-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .features-badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-sage);
    padding: 2px 10px;
    display: inline-block;
  }

  .features-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.8vw, 2.75rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .highlight-word {
    font-style: italic;
    color: var(--accent-sage-dark);
    padding: 0 4px;
  }

  .features-subtitle {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .feature-card {
    background: #ffffff;
    padding: 36px 32px;
    border-radius: 4px;
    box-shadow: 0 8px 28px rgba(37, 56, 48, 0.05);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feature-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px dashed rgba(37, 56, 48, 0.12);
  }

  .feature-chip {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-sage);
    padding: 2px 8px;
  }

  .feature-meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .feature-heading {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.015em;
  }

  .feature-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .category-pill {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 3px 8px;
  }

  .mini-prompt-preview {
    background: var(--bg-sage-subtle);
    padding: 14px 16px;
    border-radius: 6px;
    margin-top: auto;
  }

  .preview-quote {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-primary);
    font-style: italic;
    display: block;
  }

  .weather-week-box {
    background: var(--bg-sage-subtle);
    padding: 18px 20px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: auto;
  }

  .weather-days {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .day-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .day-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .weather-icon {
    font-size: 1.15rem;
  }

  .day-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot-calm { background: var(--accent-sage); }
  .dot-grateful { background: #d4a373; }
  .dot-grounded { background: #588157; }
  .dot-neutral { background: #a3b18a; }
  .dot-rainy { background: #71877c; }

  .weather-insight-line {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8125rem;
    padding-top: 10px;
    border-top: 1px dashed rgba(37, 56, 48, 0.1);
  }

  .insight-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-sage);
    letter-spacing: 0.04em;
  }

  .insight-text {
    color: var(--text-secondary);
  }

  .security-toggles-box {
    background: var(--bg-sage-subtle);
    padding: 16px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
  }

  .toggle-row {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    user-select: none;
  }

  .toggle-wrap {
    display: inline-flex;
    position: relative;
    width: 44px;
    height: 24px;
    flex-shrink: 0;
  }

  .toggle-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .audio-demo-box {
    background: var(--bg-sage-subtle);
    padding: 16px 20px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
  }

  .audio-player-mock {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .audio-play-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent-sage-dark);
    border: none;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .audio-play-btn:hover {
    transform: scale(1.05);
  }

  .audio-waveform-bars {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-grow: 1;
    height: 24px;
  }

  .bar {
    width: 3px;
    background: var(--accent-sage);
    border-radius: 2px;
    opacity: 0.75;
  }

  .bar-1 { height: 8px; }
  .bar-2 { height: 14px; }
  .bar-3 { height: 22px; }
  .bar-4 { height: 18px; }
  .bar-5 { height: 12px; }
  .bar-6 { height: 24px; }
  .bar-7 { height: 16px; }
  .bar-8 { height: 20px; }
  .bar-9 { height: 10px; }
  .bar-10 { height: 6px; }

  .audio-length {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .audio-caption {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: 1fr;
      max-width: 600px;
      margin: 0 auto;
    }

    .features-section {
      padding: 64px 20px;
    }
  }
</style>
